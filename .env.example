# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# Service role (server-side only, NEVER expose to browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Scraper
SCRAPER_SECRET=your-scraper-secret-here

# Vercel Cron (set in Vercel project env, do NOT expose to browser)
CRON_SECRET=your-cron-secret-here

# AI Caption Generation (get keys from Groq Cloud & Google AI Studio)
GROQ_API_KEY=
GEMINI_API_KEY=